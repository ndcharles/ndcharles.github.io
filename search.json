---
layout: null
sitemap: false
---
{% assign docs = "" | split: "" %}{% for page in site.pages %}{% unless page.url contains '.xml' or page.url contains '.json' or page.url contains '.txt' or page.url contains 'assets' or page.url == '/404.html' %}{% assign docs = docs | push: page %}{% endunless %}{% endfor %}[{% for page in docs %}
  {"url": {{ page.url | prepend: site.baseurl | prepend: site.url | jsonify }}, "title": {{ page.title | jsonify }}, "body": {{ page.content | markdownify | replace: '</h2>', ': ' | replace: '</h3>', ': ' | replace: '</h4>', ': ' | strip_html | normalize_whitespace | jsonify }}},{% endfor %}{% for post in site.posts %}
  {"url": {{ post.url | prepend: site.baseurl | prepend: site.url | jsonify }}, "title": {{ post.title | jsonify }}, "body": {{ post.date | date: "%Y/%m/%d" | append: " - " | append: post.content | replace: '</h2>', ': ' | replace: '</h3>', ': ' | replace: '</h4>', ': ' | strip_html | normalize_whitespace | jsonify }}}{% if forloop.last == false or site['b-roll'].size > 0 %},{% endif %}{% endfor %}{% for note in site['b-roll'] %}
  {"url": {{ note.url | prepend: site.baseurl | prepend: site.url | jsonify }}, "title": {{ note.title | jsonify }}, "body": {{ note.date | date: "%Y/%m/%d" | append: " - " | append: note.content | markdownify | strip_html | normalize_whitespace | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}
]
