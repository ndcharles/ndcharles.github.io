---
layout: null
sitemap: false
---
{%- comment -%}
Site search index, loaded by assets/js/search.js on the first search.
Pages, posts, B-Roll notes and portfolio projects in one list.
{%- endcomment -%}
{%- assign pages = "" | split: "" -%}
{%- for page in site.pages -%}
  {%- unless page.url contains '.xml' or page.url contains '.json' or page.url contains '.txt' or page.url contains 'assets' or page.url == '/404.html' or page.sitemap == false -%}
    {%- assign pages = pages | push: page -%}
  {%- endunless -%}
{%- endfor -%}
{%- assign projects = site.portfolio | where_exp: "p", "p.external_url == nil" -%}
{%- assign docs = pages | concat: site.posts | concat: site['b-roll'] | concat: projects -%}
[{% for doc in docs %}
  {%- capture body -%}{% if doc.date and doc.collection != "portfolio" %}{{ doc.date | date: "%Y/%m/%d" }} - {% endif %}{{ doc.description }} {{ doc.content | markdownify | replace: '</h2>', ': ' | replace: '</h3>', ': ' | replace: '</h4>', ': ' }}{%- endcapture %}
  {"url": {{ doc.url | prepend: site.baseurl | prepend: site.url | jsonify }}, "title": {{ doc.title | jsonify }}, "body": {{ body | strip_html | normalize_whitespace | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
